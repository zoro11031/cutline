# Upload the generated source tarball to the GitHub release and declare
# the upstream license before publishing to the AUR.
pkgname=silhouette-control-center
pkgver=0.1.0
pkgrel=1
pkgdesc='Verified Silhouette Cameo card cut templates and cutting'
provides=('cut-proxies')
conflicts=('cut-proxies')
arch=('any')
url='https://github.com/zoro11031/silhouette-linux'
license=('LicenseRef-Unknown')
depends=('python>=3.10' 'pyside6>=6.4' 'python-pillow' 'poppler' 'geos>=3.10' 'pango')
optdepends=('python-gobject: GTK fallback frontend'
            'python-cairo: GTK fallback canvas'
            'libadwaita: GTK fallback widgets'
            'qt6-wayland: native Qt support under Wayland'
            'python-pyusb: USB cutter transport and registration readback'
            'libusb: USB backend'
            'python-bleak: Bluetooth LE cutter transport'
            'bluez: system Bluetooth service'
            'python-rich: formatted terminal output')
makedepends=('python')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

check() {
  cd "$pkgname-$pkgver"
  python -c 'from cut_proxies.job import build; assert not build().blocked'
}

package() {
  cd "$pkgname-$pkgver"
  python packaging/install.py --destdir "$pkgdir"
}
